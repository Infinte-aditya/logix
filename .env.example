# Copy to .env and adjust. Never commit real secrets (.env is gitignored).
# See AGENTS.md for the contract.

# Redis connection used by all services
REDIS_URL=redis://localhost:6379/0

# Shared log file path (inside containers this is the `logdata` volume)
LOG_PATH=/data/app.log

# Detector window size in seconds
WINDOW_SECONDS=60

# Redis pub/sub channel for alert messages
ALERT_CHANNEL=alerts

# AWS region for the notifier
AWS_REGION=eu-west-1

# Target SNS topic (placeholder ARN; use LocalStack for local dev)
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:log-alerts

# Optional: point AWS SDK at LocalStack instead of real AWS
AWS_ENDPOINT_URL=http://localhost:4566

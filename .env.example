# Copy to .env and adjust. Never commit real secrets (.env is gitignored).

# Redis connection used by all services
REDIS_URL=redis://localhost:6379/0

# Shared log file path (inside containers this is the `logdata` volume)
LOG_PATH=/data/app.log

# Redis pub/sub channel for alert messages
ALERT_CHANNEL=alerts

# Detector window (overridden by settings in Redis)
WINDOW_SECONDS=60

# Detector EWMA alpha (overridden by settings in Redis)
ALPHA=0.05

# Detector warmup (overridden by settings in Redis)
WARMUP_SECONDS=120

# CORS origins for the gateway WebSocket
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# AWS region for the notifier
AWS_REGION=eu-west-1

# Target SNS topic (placeholder ARN; use LocalStack for local dev)
SNS_TOPIC_ARN=arn:aws:sns:eu-west-1:000000000000:log-alerts

# Optional: point AWS SDK at LocalStack instead of real AWS
AWS_ENDPOINT_URL=http://localhost:4566

# Optional: mock AWS credentials (for moto/LocalStack only)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Notifier dedup cooldown in seconds (default 60)
NOTIFIER_COOLDOWN=60

# Notifier digest mode: batch LOW/MEDIUM alerts for N seconds (0 = off)
NOTIFIER_DIGEST_SECONDS=0